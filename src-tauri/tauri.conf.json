{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyber War",
  "version": "0.4.2",
  "identifier": "com.gamehacker.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cyber War",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": true,
        "decorations": true,
        "center": true,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "targets": ["nsis", "msi"],
    "category": "Game",
    "shortDescription": "Thriller de investigação e hacking em um Kali Linux simulado.",
    "longDescription": "Cyber War é um jogo desktop de investigação e hacking cujo computador, terminal, filesystem e redes existem dentro de uma sandbox virtual.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
