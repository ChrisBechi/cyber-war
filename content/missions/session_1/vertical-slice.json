  {
    "id": "pendrive",
    "title": "O Pendrive",
    "description": "Recupere as fotos do seu tio. Ter acesso não significa ter direito de olhar.",
    "contact": "Mãe",
    "session": 1,
    "requirements": [
      {
        "kind": "flag",
        "key": "V2_COMPLETE"
      }
    ],
    "startTriggers": [],
    "onStart": [
      {
        "kind": "message",
        "contact": "Mãe",
        "text": "São fotos antigas. Trabalhe numa cópia do pendrive."
      }
    ],
    "stages": [
      {
        "objective": "Preserve uma imagem em Documents/usb-backup.img.",
        "hint": "cp /dev/usb.img Documents/usb-backup.img",
        "conditions": [
          {
            "kind": "fileContains",
            "path": "/home/kali/Documents/usb-backup.img",
            "text": "FOTO_01"
          }
        ],
        "choices": [],
        "effects": []
      },
      {
        "objective": "Recupere as fotos da cópia.",
        "hint": "lab recover exige a imagem preservada.",
        "conditions": [
          {
            "kind": "flag",
            "key": "USB_RECOVERED"
          }
        ],
        "choices": [],
        "effects": []
      },
      {
        "objective": "Decida o que fazer com o arquivo pessoal.",
        "hint": "As fotos já foram recuperadas. A investigação é opcional.",
        "conditions": [
          {
            "kind": "flag",
            "key": "USB_DECIDED"
          }
        ],
        "choices": [
          {
            "id": "respect",
            "label": "Entregar as fotos e respeitar a privacidade",
            "irreversible": true,
            "effects": [
              {
                "kind": "flag",
                "key": "USB_DECIDED"
              },
              {
                "kind": "decision",
                "key": "unclePrivacy",
                "value": "respected"
              }
            ]
          },
          {
            "id": "look",
            "label": "Investigar o arquivo pessoal",
            "irreversible": true,
            "effects": [
              {
                "kind": "flag",
                "key": "USB_DECIDED"
              },
              {
                "kind": "decision",
                "key": "unclePrivacy",
                "value": "opened"
              },
              {
                "kind": "message",
                "contact": "LifeOS",
                "text": "Reservas e conversas revelam uma amante. É um segredo humano, sem ligação com o submundo."
              }
            ]
          }
        ],
        "effects": []
      }
    ],
    "outcomes": [
      {
        "kind": "flag",
        "key": "PENDRIVE_COMPLETE"
      },
      {
        "kind": "reward",
        "money": 0,
        "reputation": 3
      },
      {
        "kind": "message",
        "contact": "Mãe",
        "text": "Seu tio agradeceu pelas fotos."
      }
    ]
